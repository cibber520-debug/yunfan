# 前端生产构建变量（Vite build-time 注入，部署后不可改）
# 复制本文件为 .env.production，填写真实后端域名，再执行 pnpm build。
# 注意：Vite 的 import.meta.env.* 在 pnpm build 时写死进 dist/，部署后无法更改。

# 数据来源：走真实后端 API
VITE_DATA_SOURCE=api

# 云托管后端域名（部署 T6 取得后端域名后回填，末尾不要带 /）
# 例如：https://your-backend.ap-shanghai.run.tcloudbase.com
VITE_API_BASE_URL=https://your-backend.ap-shanghai.run.tcloudbase.com

# 是否启用真实账户体系：true 启用（生产必须）
VITE_AUTH_ENABLED=true
