{
  "name": "yunfan-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "云帆志愿后端：本地运行，提供引用数据 / 位次反查 / 志愿推荐三个接口（阶段一无数据库，阶段二 PostgreSQL）",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:migrate:auth": "tsx scripts/migrate-auth.ts",
    "test:auth:e2e": "npm run db:migrate:auth && tsx scripts/auth-e2e.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "nodemailer": "6.9.16",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
